# Database (SQLite default, easily portable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Optional Basic Auth for hosted deployments
# Leave commented for local/desktop use. Set RORILO_AUTH_SECRET to require login.
# RORILO_AUTH_USER="rorilo"
# RORILO_AUTH_SECRET=""

# AI Provider Settings (OpenAI-compatible providers)
# Can also be configured directly via the Settings UI in the app
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-5.4-mini"

# Apify Settings (Job Discovery Scraper)
# Can also be configured directly via the Settings UI in the app
APIFY_TOKEN=""
APIFY_ACTOR_ID="curious_coder/linkedin-salary-scraper"

# Google / Gmail OAuth (for application email drafts)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# logo.dev (optional company logos beside job listings)
# Can also be configured directly via the Settings UI in the app
LOGO_DEV_TOKEN=""

# Free job sources (no Apify cost). Bundesagentur needs no keys at all.
# Adzuna API (free signup at developer.adzuna.com)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Techmap API (free Basic plan on RapidAPI)
TECHMAP_API_KEY=""
